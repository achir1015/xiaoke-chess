{
  "name": "xiaoke-chess",
  "productName": "小柯機器人象棋遊戲",
  "version": "1.0.0",
  "description": "小柯機器人象棋遊戲：3D 中國象棋（與 AI 對賽、遠端真人對賽、語音通話、背景音樂、AI 軍師、自動學習棋譜）",
  "main": "src/main/main.js",
  "author": {
    "name": "吳玉柱",
    "email": "achir1015@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "e2e": "node e2e/run.mjs",
    "music": "python scripts/gen_music.py",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "peerjs": "1.5.5",
    "three": "0.170.0"
  },
  "build": {
    "appId": "com.achir.xiaokechess",
    "productName": "小柯機器人象棋遊戲",
    "artifactName": "XiaokeChess-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 吳玉柱",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/three/examples/**",
      "!node_modules/three/src/**",
      "!node_modules/**/test/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.mts"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "XiaokeChess"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小柯機器人象棋遊戲",
      "uninstallDisplayName": "小柯機器人象棋遊戲",
      "language": "1028",
      "installerLanguages": [
        "zh_TW"
      ]
    },
    "portable": {
      "artifactName": "XiaokeChess-${version}-win-x64-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.board-games",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "與遠端棋友語音通話需要使用麥克風。"
      },
      "identity": "-"
    },
    "dmg": {
      "title": "小柯機器人象棋遊戲 ${version}"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "peer": "^1.0.2",
    "playwright-core": "^1.48.2"
  }
}
